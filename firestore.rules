rules_version = '2';

// IntelliQA — Firestore Security Rules (v2: approval workflow)
// วางเนื้อหาไฟล์นี้ที่ Firebase Console → Firestore Database → Rules → Publish
//
// นโยบาย:
//  1. ต้อง login และ email ลงท้าย @fabfood.co.th
//  2. บัญชีใหม่สถานะ pending — เข้าถึงข้อมูลไม่ได้จนกว่า admin จะอนุมัติ
//  3. admin (pakarang.sa@fabfood.co.th) เท่านั้นที่อนุมัติ/เปลี่ยนโรล/จัดการผู้ใช้ได้
//  4. ผู้ใช้เปลี่ยนโรล/สถานะของตัวเองไม่ได้ (กันสมัครแล้วเลือกสิทธิ์สูงเอง)

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@fabfood[.]co[.]th');
    }

    function isAdmin() {
      return isTeam() && request.auth.token.email == 'pakarang.sa@fabfood.co.th';
    }

    function isApproved() {
      return isAdmin() || (
        isTeam()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Shared record stores — เฉพาะผู้ใช้ที่อนุมัติแล้ว
    match /audits/{doc}   { allow read, write: if isApproved(); }
    match /cleaning/{doc} { allow read, write: if isApproved(); }
    match /supplier/{doc} { allow read, write: if isApproved(); }
    match /customer/{doc} { allow read, write: if isApproved(); }
    match /parts/{doc}    { allow read, write: if isApproved(); }
    match /kv/{doc}       { allow read, write: if isApproved(); }

    // User profiles / approval workflow
    match /users/{uid} {
      // อ่าน: admin อ่านได้ทุกคน, ผู้ใช้อ่านได้เฉพาะของตัวเอง (ไว้เช็คสถานะ)
      allow read: if isAdmin() || (isTeam() && request.auth.uid == uid);
      // สมัคร: สร้างโปรไฟล์ตัวเองได้ แต่สถานะต้องเป็น pending เท่านั้น
      allow create: if isAdmin() || (
        isTeam() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
      );
      // แก้ไข/อนุมัติ/เปลี่ยนโรล/ลบ: admin เท่านั้น
      allow update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} { allow read, write: if false; }
  }
}
